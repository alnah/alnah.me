---
import NewsletterSignup from "../components/NewsletterSignup.astro";
import BaseLayout from "./BaseLayout.astro";
import PostFooter from "../components/PostFooter.astro";
import { formatIsoDate, getPostCategoryMeta, readingTimeFromMarkdown, resolvePostDate, resolvePublicationDate, type PostEntry } from "../lib/content/index.ts";
import { buildBlogPostingSchema } from "../lib/seo.ts";
import { resolveEntryTitle, stripLeadingMarkdownTitle } from "../lib/document-title.ts";
import {
  categoryPath,
  postPath,
  postSocialImagePath,
  rawPostPath
} from "../lib/site-paths.ts";

interface Props {
  entry: PostEntry;
}

const { entry } = Astro.props;
const documentTitle = resolveEntryTitle(entry);
const readingTime = readingTimeFromMarkdown(stripLeadingMarkdownTitle(entry.body ?? ""));
const publicationDate = resolvePublicationDate(entry.data);
const postDate = resolvePostDate(publicationDate, entry.data.lastmod);
const canonicalPath = postPath(entry.id);
const reuseUrl = rawPostPath(entry.id);
const socialImage = postSocialImagePath(entry.id);
const socialImageAlt = `Image de partage pour ${documentTitle}.`;
const categoryMeta = getPostCategoryMeta(entry.data.category);
const schemaJson = buildBlogPostingSchema({
  canonicalUrl: new URL(canonicalPath, Astro.site).toString(),
  category: categoryMeta.label,
  dateModified: postDate.date,
  datePublished: publicationDate,
  description: entry.data.description,
  image: socialImage,
  tags: entry.data.tags,
  title: documentTitle
});
---

<BaseLayout
  title={documentTitle}
  description={entry.data.description}
  canonicalPath={canonicalPath}
  image={socialImage}
  imageAlt={socialImageAlt}
  imageWidth={1200}
  imageHeight={630}
  modifiedTime={postDate.date.toISOString()}
  publishedTime={publicationDate.toISOString()}
  schemaJson={schemaJson}
  reuseUrl={reuseUrl}
  type="article"
>
  <article class="post-shell content-band page-pad-top">
    <div class="post-article prose reading-column">
      <header class="post-header">
        <p class="post-category">
          <a class="category-pill" href={categoryPath(categoryMeta.slug)}>{categoryMeta.label}</a>
        </p>
        <p class="eyebrow post-meta">
          <time datetime={formatIsoDate(postDate.date)}>{postDate.label}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime} min de lecture</span>
        </p>
      </header>
      <slot />
      <PostFooter
        slug={entry.id}
        title={documentTitle}
        category={entry.data.category}
        tags={entry.data.tags}
      />
    </div>
  </article>
  <section class="signup-shell content-band">
    <NewsletterSignup />
  </section>
</BaseLayout>

<style>
  .post-shell {
    width: min(100%, var(--width-band));
    margin-inline: auto;
  }

  .post-header {
    margin-bottom: var(--space-4);
  }

  .post-meta {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
    text-transform: none;
  }

  .post-category {
    margin: 0 0 var(--space-3);
    font-family: var(--font-body);
    font-size: var(--font-size-compact-sm);
    line-height: 1.4;
  }

  .post-article > h1 + p {
    margin-top: 0;
    margin-bottom: var(--space-6);
    color: var(--color-text-muted);
    max-width: 58ch;
    font-size: var(--font-size-lg);
  }

  .signup-shell {
    margin-top: var(--space-6);
  }

  @media (min-width: 901px) {
    .post-shell {
      padding-top: var(--space-8);
    }

    .post-article > h1 + p {
      font-size: var(--font-size-xl);
    }

    .signup-shell {
      margin-top: var(--space-7);
    }
  }
</style>
