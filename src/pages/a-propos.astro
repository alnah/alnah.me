---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import GitHubActivity from "../components/GitHubActivity.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import profileImage from "../assets/profile.jpeg";
import { SITE } from "../config/site";
import { getPageContent } from "../lib/content";
import { resolveEntryTitle } from "../lib/document-title.js";
import { buildProfilePageSchema } from "../lib/seo";

const page = await getPageContent("a-propos");

if (!page) {
  throw new Error("Missing about page content");
}

const pageTitle = resolveEntryTitle(page);
const pageDescription = page.data.description ?? SITE.description;
const signupMarker = "<!-- newsletter-signup -->";
const [beforeSignup, afterSignup] = page.body.split(signupMarker);

if (!beforeSignup || afterSignup === undefined) {
  throw new Error("About page is missing the newsletter marker for signup placement");
}

const markdownProcessor = await createMarkdownProcessor();
const { code: beforeSignupHtml } = await markdownProcessor.render(beforeSignup);
const { code: afterSignupHtml } = await markdownProcessor.render(afterSignup);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schemaJson={buildProfilePageSchema({
    canonicalUrl: new URL("/a-propos/", Astro.site).toString(),
    description: pageDescription,
    title: SITE.author.name
  })}
>
  <section class="page-shell page-stack page-pad-top content-band">
    <div class="prose about-copy reading-column">
      <Fragment set:html={beforeSignupHtml} />
      <NewsletterSignup />
      <Fragment set:html={afterSignupHtml} />
      <figure class="about-portrait">
        <Image
          class="about-portrait-image"
          src={profileImage}
          width="200"
          height="200"
          alt={SITE.author.photoAlt}
          fit="cover"
        />
      </figure>
    </div>
    <GitHubActivity />
  </section>
</BaseLayout>

<style>
  .about-portrait {
    display: flex;
    justify-content: center;
    margin: var(--space-6) 0 0;
  }

  .about-portrait-image {
    width: clamp(7rem, 30vw, 10rem);
    height: auto;
    border-radius: 999px;
    border: 1px solid var(--color-rule);
    background: var(--color-surface-strong);
    box-shadow: var(--shadow-sm);
  }
</style>
