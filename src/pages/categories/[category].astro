---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import ArchiveIntro from "../../components/ArchiveIntro.astro";
import {
  getCategories,
  getPostsByCategory
} from "../../lib/content/index.ts";

/**
 * An archive with no post is not a page: it would be a thin, empty duplicate
 * of `/categories/`. The category reappears as soon as one post is published.
 */
export async function getStaticPaths() {
  const categories = (await getCategories()).filter((category) => category.count > 0);
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category }
  }));
}

const { category } = Astro.props;
const posts = await getPostsByCategory(category.slug);
---

<BaseLayout
  title={`Articles classés dans ${category.label}`}
  description={category.description}
>
  <section class="archive-shell content-band">
    <ArchiveIntro
      eyebrow="Archive de catégorie"
      title={category.label}
      description={category.description}
    >
      <p>{category.count} article(s) classé(s) dans cette catégorie.</p>
    </ArchiveIntro>
    <PostList posts={posts} showReadingTime />
  </section>
</BaseLayout>
