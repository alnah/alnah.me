---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import ArchiveIntro from "../../components/ArchiveIntro.astro";
import {
  getCategories,
  getPostsByCategory,
  isPostCategory
} from "../../lib/content";

export async function getStaticPaths() {
  const categories = await getCategories();
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category }
  }));
}

const { category } = Astro.props;
const posts = isPostCategory(category.slug)
  ? await getPostsByCategory(category.slug)
  : [];
---

<BaseLayout
  title={`Articles classés dans ${category.label}`}
  description={category.description}
>
  <section class="archive-shell content-band">
    <ArchiveIntro
      eyebrow="Archive de catégorie"
      title={category.label}
      description={category.description}
    >
      <p>{category.count} article(s) classé(s) dans cette catégorie.</p>
    </ArchiveIntro>
    {
      posts.length > 0 ? (
        <PostList posts={posts} showReadingTime />
      ) : (
        <p class="empty-state">Aucun article publié dans cette catégorie pour le moment.</p>
      )
    }
  </section>
</BaseLayout>
