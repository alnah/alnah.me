---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import ArchiveIntro from "../../components/ArchiveIntro.astro";
import { getPostsByTag, getTags } from "../../lib/content";

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag }
  }));
}

const { tag } = Astro.props;
const posts = await getPostsByTag(tag.slug);
---

<BaseLayout
  title={`Articles étiquetés ${tag.label}`}
  description={`Articles étiquetés ${tag.label}`}
>
  <section class="archive-shell content-band">
    <ArchiveIntro eyebrow="Archive d'étiquettes" title={`#${tag.label}`}>
      <p>{tag.count} article(s) classé(s) sous cette étiquette.</p>
    </ArchiveIntro>
    <PostList posts={posts} />
  </section>
</BaseLayout>
