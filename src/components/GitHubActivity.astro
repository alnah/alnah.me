---
import ContributionCalendar from "./ContributionCalendar.astro";
import RecentActivity from "./RecentActivity.astro";
import { SITE } from "../config/site.ts";
import { getGitHubActivity } from "../lib/github.ts";
import { buildGitHubActivityView } from "../lib/github-view.ts";

const activity = await getGitHubActivity(SITE.githubActivity);
const { monthColumns, recentItems, visibleWeeks, weekCount, weekdayLabels } = buildGitHubActivityView(activity);
---

{
  activity.hasLiveData && (
    <section
      class="github-activity section-rule"
      style="padding-top: var(--github-activity-space, 1.5rem);"
    >
      <div class="eyebrow">Activité GitHub</div>
      <ContributionCalendar
        totalContributions={activity.totalContributions}
        {monthColumns}
        {visibleWeeks}
        {weekdayLabels}
        {weekCount}
      />
      {recentItems.length > 0 && <RecentActivity items={recentItems} />}
      <p>
        <a href={activity.profileUrl} target="_blank" rel="noreferrer">
          Suivre mon activité publique sur GitHub
        </a>
      </p>
    </section>
  )
}

<style>
  .github-activity {
    --github-activity-space: var(--space-5);
    padding-top: var(--space-5);
    display: grid;
    gap: var(--space-4);
    width: 100%;
    max-width: min(100%, var(--width-band));
    margin-inline: 0;
  }
</style>
