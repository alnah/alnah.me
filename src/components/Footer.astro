---
import ContactLinks from "./ContactLinks.astro";
import { SITE } from "../config/site.ts";

interface Props {
  reuseUrl?: string;
}

const { reuseUrl = SITE.reuseUrl } = Astro.props;
const isPostFooter = reuseUrl !== SITE.reuseUrl;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="content-band footer-inner section-rule">
    <div class="footer-copy">
      <p class="footer-copyright">
        <a href={SITE.aboutPath}>© {currentYear} {SITE.author.name}</a>
      </p>
      <div class="footer-links">
        {
          isPostFooter && (
            <>
              <a href={reuseUrl}>Réutiliser cet article</a>
              <span aria-hidden="true">·</span>
            </>
          )
        }
        <a href={SITE.reuseUrl}>CC BY 4.0 / BSD 3-Clause</a>
        <span aria-hidden="true">·</span>
        <a href={SITE.repoUrl} target="_blank" rel="noreferrer">github.com/alnah/alnah.me</a>
      </div>
    </div>
    <ContactLinks variant="footer" />
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-5) 0 var(--space-2);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    align-items: start;
    padding-top: var(--space-5);
  }

  .footer-copy {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    font-family: var(--font-body);
    font-size: inherit;
    line-height: var(--line-height-normal);
  }

  .footer-copyright {
    display: flex;
    align-items: center;
    min-height: 2rem;
    margin: 0;
    color: var(--color-text-muted);
  }

  .footer-links {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    align-items: center;
    min-height: 2rem;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer :global(.contact-links) {
    min-width: 0;
  }

  @media (min-width: 901px) {
    .footer-copy {
      max-width: 65%;
    }
  }

  @media (max-width: 900px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 480px) {
    .site-footer {
      padding-top: var(--space-4);
      font-size: var(--font-size-compact);
    }

    .footer-inner {
      gap: var(--space-4);
      align-items: center;
      text-align: center;
    }

    .footer-copy {
      display: grid;
      gap: var(--space-2);
      align-items: center;
      justify-items: center;
      width: 100%;
    }

    .footer-links {
      display: grid;
      gap: var(--space-2);
      justify-items: center;
      min-height: 0;
    }

    .footer-copy span[aria-hidden="true"] {
      display: none;
    }
  }
</style>
