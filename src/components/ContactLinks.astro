---
import { SITE, SOCIAL_CONTACT_IDS } from "../config/site";
import type { ContactId } from "../config/site";
import SocialIcon from "./SocialIcon.astro";

interface Props {
  variant?: "hero" | "footer";
}

const { variant = 'hero' } = Astro.props;

const contactIds: readonly ContactId[] = ['email'];
const socialItems = SITE.contacts.filter((contact) => SOCIAL_CONTACT_IDS.includes(contact.id));
const contactItems = SITE.contacts.filter((contact) => contactIds.includes(contact.id));
---

<div class="contact-links" data-variant={variant} aria-label="Liens de contact">
  {socialItems.length > 0 && (
    <div class="social-row">
      <span class="social-row-label">Me suivre sur</span>
      <div class="social-links-list">
        {socialItems.map((contact) => (
          <a
            class="social-icon-link"
            href={contact.href}
            aria-label={contact.label}
            title={contact.label}
            target={contact.href.startsWith("/") ? undefined : "_blank"}
            rel={contact.href.startsWith("/") ? undefined : "noreferrer"}
          >
            <SocialIcon icon={contact.id as ContactId} />
          </a>
        ))}
      </div>
    </div>
  )}

  {contactItems.length > 0 && (
    <div class="social-row">
      <span class="social-row-label">Me contacter par</span>
      <div class="social-links-list">
        {contactItems.map((contact) => (
          <a
            class="social-icon-link"
            href={contact.href}
            aria-label={contact.label}
            title={contact.label}
            target={contact.href.startsWith("/") ? undefined : "_blank"}
            rel={contact.href.startsWith("/") ? undefined : "noreferrer"}
          >
            <SocialIcon icon={contact.id as ContactId} />
          </a>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  .contact-links {
    display: grid;
    gap: var(--space-2);
  }

  .contact-links[data-variant="hero"] .social-row {
    justify-content: center;
  }

  @media (max-width: 480px) {
    .contact-links[data-variant="footer"] {
      width: 100%;
    }

    .contact-links[data-variant="footer"] .social-row {
      justify-content: center;
      flex-wrap: wrap;
      row-gap: var(--space-2);
    }

    .contact-links[data-variant="footer"] .social-row-label {
      flex-basis: 100%;
      text-align: center;
    }

    .contact-links[data-variant="footer"] .social-links-list {
      justify-content: center;
      flex-wrap: wrap;
      max-width: 100%;
    }
  }

</style>
