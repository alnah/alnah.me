---
import { formatDate, getPostCategoryMeta, readingTimeFromText, resolvePublicationDate, type PostEntry } from "../lib/content";
import { resolveEntryTitle, stripLeadingMarkdownTitle } from "../lib/document-title.js";

interface Props {
  posts: PostEntry[];
  showReadingTime?: boolean;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  posts,
  showReadingTime = false,
  ctaHref,
  ctaLabel
} = Astro.props;
---

<div class="post-list">
  {posts.map((post) => (
    <article class="post-list-item">
      <p class="post-list-category">
        <a class="category-pill" href={`/categories/${post.data.category}/`}>
          {getPostCategoryMeta(post.data.category).label}
        </a>
      </p>
      <p class="eyebrow post-list-meta">
        <span>{formatDate(resolvePublicationDate(post.data))}</span>
        {
          showReadingTime && (
            <>
              <span aria-hidden="true">·</span>
              <span>{readingTimeFromText(stripLeadingMarkdownTitle(post.body ?? ""))} min de lecture</span>
            </>
          )
        }
      </p>
      <div class="post-list-copy">
        <h3><a href={`/articles/${post.id}/`}>{resolveEntryTitle(post)}</a></h3>
        <p>{post.data.description}</p>
      </div>
    </article>
  ))}
  {
    ctaHref && ctaLabel && (
      <div class="post-list-cta">
        <a class="post-list-link" href={ctaHref}>{ctaLabel}</a>
      </div>
    )
  }
</div>

<style>
  .post-list {
    display: grid;
    gap: var(--space-6);
    max-width: var(--width-reading);
    margin-inline: auto;
  }

  .post-list-item {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-rule);
  }

  .post-list-meta {
    margin: 0;
    display: flex;
    gap: var(--space-2);
    align-items: center;
    flex-wrap: wrap;
  }

  .post-list-copy h3 {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    margin: 0 0 var(--space-2);
  }

  .post-list-category {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--font-size-compact-sm);
    line-height: 1.4;
  }

  .post-list-copy p {
    margin: 0;
    color: var(--color-text-muted);
    text-align: left;
  }

  .post-list-cta {
    padding-top: var(--space-2);
  }

  .post-list-link {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  @media (min-width: 901px) {
    .post-list {
      gap: var(--space-7);
    }
  }
</style>
