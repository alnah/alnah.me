---
import ShareLinks from "./ShareLinks.astro";
import { getPostCategoryMeta, slugify, type PostCategory } from "../lib/content";

interface Props {
  slug: string;
  title: string;
  category: PostCategory;
  tags: string[];
}

const { slug, title, category, tags } = Astro.props;
const canonicalUrl = new URL(`/articles/${slug}/`, Astro.site).toString();
const categoryMeta = getPostCategoryMeta(category);
---

<footer class="post-footer section-rule">
  <div class="category-row">
    <a class="category-pill category-pill--accent" href={`/categories/${categoryMeta.slug}/`}>
      {categoryMeta.label}
    </a>
  </div>
  <div class="tag-row">
    {tags.map((tag) => (
      <a class="tag" href={`/etiquettes/${slugify(tag)}/`}>#{tag}</a>
    ))}
  </div>
  <ShareLinks canonicalUrl={canonicalUrl} title={title} />
  <div class="post-footer-bottom">
    <a href="/articles/">Tous les articles</a>
  </div>
</footer>

<style>
  .post-footer {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    display: grid;
    gap: var(--space-4);
  }

  .category-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  .tag-row {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
  }

  .tag {
    color: var(--color-text-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .tag:hover {
    border-color: currentColor;
  }

  .post-footer-bottom {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    text-align: center;
  }

  .post-footer-bottom a {
    text-decoration: none;
  }
</style>
