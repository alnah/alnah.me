{
  "name": "alnah-me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "prepare:static": "node scripts/prepare-static.ts",
    "predev": "npm run prepare:static",
    "dev": "astro dev --force",
    "prebuild": "npm run prepare:static",
    "postbuild": "node scripts/generate-headers.ts",
    "build": "rm -rf dist .astro && astro build",
    "preview": "astro preview",
    "test:unit": "node --test scripts/test-unit/*.test.ts",
    "test:domain": "node --test scripts/test-domain/*.test.ts",
    "test:build": "npm run build && node scripts/test-build.ts",
    "test:ui": "npm run build && playwright test",
    "verify": "npm run build && astro check && node scripts/verify.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@panzoom/panzoom": "^4.6.2",
    "astro": "^7.4.4",
    "gray-matter": "^4.0.3",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "parse5": "^8.1.1",
    "playwright": "^1.64.1",
    "satori": "^0.63.2",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "fflate": "^0.8.3"
  }
}
