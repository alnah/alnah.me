{
  "name": "alnah-me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:static": "node scripts/prepare-static.mjs",
    "predev": "npm run prepare:static",
    "dev": "astro dev",
    "prebuild": "npm run prepare:static",
    "postbuild": "node scripts/generate-headers.mjs",
    "build": "rm -rf dist .astro && astro build",
    "preview": "astro preview",
    "test:unit": "node scripts/test-unit.mjs",
    "test:acceptance": "npm run build && node scripts/test-acceptance.mjs",
    "test:integration": "npm run build && node scripts/test-integration.mjs",
    "test:e2e": "npm run build && node scripts/test-e2e.mjs",
    "test:ui": "npm run build && node scripts/test-ui.mjs",
    "verify": "npm run build && astro check && node scripts/verify.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.4.4",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "playwright": "^1.64.1",
    "typescript": "^5.9.2"
  }
}
